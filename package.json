{
  "name": "ellofive",
  "version": "1.4.0",
  "description": "ElloFive + Ello5 AI mode (ello5.com) — Elite Coding System with FRC7, DeepFakes, API & UI",
  "type": "module",
  "bin": {
    "ellofive": "./bin/ellofive",
    "ellofive-frc": "./frc/cli.js",
    "ellofive-dl": "./bin/ellofive-dl",
    "ellofive-memory": "./bin/ellofive-memory"
  },
  "scripts": {
    "setup": "bash scripts/setup-model.sh",
    "build:modelfile": "bash scripts/build-modelfile.sh",
