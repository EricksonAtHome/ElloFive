# Ello5 AI mode hosts (ello5.com)
# Ello5 is only an AI mode — map these in DNS + Caddy/nginx.

ELLO5_DOMAIN=ello5.com

# Public surfaces
ELLO5_UI_HOST=ai.ello5.com
ELLO5_API_HOST=api.ello5.com

# Server fleet — where the model runs
ELLO5_RUNTIME_HOST=ft.svr.ello5.com
ELLO5_SVR_ROOT=svr.ello5.com

# Origins (HTTPS in prod)
ELLO5_UI_ORIGIN=https://ai.ello5.com
ELLO5_API_ORIGIN=https://api.ello5.com
ELLO5_RUNTIME_ORIGIN=https://ft.svr.ello5.com

# CORS allow-list (comma-separated). Defaults include *.ello5.com UI hosts.
ELLO5_CORS_ORIGINS=https://ai.ello5.com,https://ello5.com,http://127.0.0.1:3000,http://localhost:3000

# Local process ports
ELLOFIVE_PORT=3000
ELLOFIVE_HOST=http://127.0.0.1:11434
OLLAMA_HOST=http://127.0.0.1:11434

# Default AI mode model
ELLO5_MODEL=ellofive
