#!/usr/bin/env bash
# ElloFive Ubuntu Cloud Lab — open Ubuntu and test apps (enterprise open-source Ubuntu).
# Used when the user says: "test my app", "open Ubuntu and check …", etc.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
LAB_ENV="${ROOT}/.ellofive-ubuntu-lab.env"
CHROME_BIN="${CHROME_BIN:-$(command -v google-chrome-stable || command -v google-chrome || command -v chromium-browser || true)}"

cmd="${1:-status}"
shift || true

load_lab_env() {
  if [[ -f "${LAB_ENV}" ]]; then
    # shellcheck disable=SC1090
    set -a
    source "${LAB_ENV}"
    set +a
  fi
}

write_lab_env() {
  cat >"${LAB_ENV}" <<EOF
# Generated by ellofive ubuntu — Ubuntu Cloud Lab
ELLOFIVE_UBUNTU_LAB=1
ELLOFIVE_UBUNTU_DISTRO="$(. /etc/os-release && echo "${PRETTY_NAME}")"
ELLOFIVE_UBUNTU_DISPLAY="${DISPLAY:-:1}"
ELLOFIVE_UBUNTU_CHROME="${CHROME_BIN}"
ELLOFIVE_UBUNTU_READY=1
EOF
}

ensure_display() {
  if [[ -z "${DISPLAY:-}" ]]; then
    export DISPLAY=:1
  fi
  if ! xdpyinfo -display "${DISPLAY}" >/dev/null 2>&1; then
    echo "Ubuntu display ${DISPLAY} is not available." >&2
    echo "Cloud Agents normally provide DISPLAY=:1 for computer-use." >&2
    return 1
  fi
}

status() {
  load_lab_env
  echo "ElloFive Ubuntu Cloud Lab"
  echo "  Distro   : $(. /etc/os-release && echo "${PRETTY_NAME}")"
  echo "  Kernel   : $(uname -r)"
  echo "  Display  : ${DISPLAY:-unset}"
  if xdpyinfo -display "${DISPLAY:-:1}" >/dev/null 2>&1; then
    echo "  Desktop  : ready (${DISPLAY:-:1})"
  else
    echo "  Desktop  : not ready"
  fi
  if [[ -n "${CHROME_BIN}" ]]; then
    echo "  Browser  : ${CHROME_BIN}"
  else
    echo "  Browser  : missing (run: ellofive ubuntu setup)"
  fi
  if [[ "${ELLOFIVE_UBUNTU_READY:-0}" == "1" ]]; then
    echo "  Lab flag : ready"
  else
    echo "  Lab flag : not marked ready"
  fi
  echo ""
  echo "When the user says \"test my app\":"
  echo "  1) ellofive ubuntu status"
  echo "  2) start the app (e.g. ellofive api / npm start)"
  echo "  3) ellofive ubuntu open http://127.0.0.1:3000"
  echo "  4) use computer-use to click/type and verify the flow"
}

setup() {
  echo "==> Ubuntu Cloud Lab setup (enterprise open-source Ubuntu)"
  if command -v apt-get >/dev/null 2>&1; then
    sudo apt-get update -qq
    sudo DEBIAN_FRONTEND=noninteractive apt-get install -y -qq \
      curl ca-certificates xdg-utils x11-utils \
      fonts-liberation fonts-dejavu-core \
      || true
  fi

  CHROME_BIN="${CHROME_BIN:-$(command -v google-chrome-stable || command -v google-chrome || command -v chromium-browser || true)}"
  if [[ -z "${CHROME_BIN}" ]]; then
    echo "==> Installing Google Chrome for Ubuntu lab testing"
    tmp="$(mktemp -d)"
    curl -fsSL https://dl.google.com/linux/direct/google-chrome-stable_current_amd64.deb -o "${tmp}/chrome.deb"
    sudo DEBIAN_FRONTEND=noninteractive apt-get install -y -qq "${tmp}/chrome.deb" || \
      sudo dpkg -i "${tmp}/chrome.deb" || true
    sudo apt-get install -y -qq -f || true
    rm -rf "${tmp}"
    CHROME_BIN="$(command -v google-chrome-stable || command -v google-chrome || true)"
  fi

  ensure_display || true
  write_lab_env
  echo "==> Ubuntu Cloud Lab ready"
  status
}

open_url() {
  local url="${1:-}"
  if [[ -z "${url}" ]]; then
    echo "Usage: ellofive ubuntu open <url>" >&2
    exit 1
  fi
  load_lab_env
  ensure_display
  CHROME_BIN="${CHROME_BIN:-$(command -v google-chrome-stable || command -v google-chrome || true)}"
  if [[ -z "${CHROME_BIN}" ]]; then
    echo "Chrome missing. Run: ellofive ubuntu setup" >&2
    exit 1
  fi
  echo "==> Opening on Ubuntu Cloud Lab: ${url}"
  nohup "${CHROME_BIN}" --no-first-run --disable-dev-shm-usage \
    --window-size=1440,900 "${url}" >/tmp/ellofive-ubuntu-chrome.log 2>&1 &
  echo "Browser PID $!  (log: /tmp/ellofive-ubuntu-chrome.log)"
  echo "AI can now computer-use the Ubuntu desktop to test the app."
}

test_app() {
  local target="${1:-http://127.0.0.1:3000}"
  load_lab_env
  status
  echo ""
  echo "==> Test-my-app brief"
  echo "Target: ${target}"
  echo "OS    : Ubuntu Cloud Lab (enterprise open source)"
  echo ""
  # If Elloten/API target, try to ensure it is up
  if [[ "${target}" == http://127.0.0.1:3000* || "${target}" == http://localhost:3000* ]]; then
    if ! curl -sf "http://127.0.0.1:3000/v1/hosts" >/dev/null 2>&1; then
      echo "Elloten API not up — starting Ollama + API…"
      if ! curl -sf http://127.0.0.1:11434/api/tags >/dev/null 2>&1; then
        nohup ollama serve >/tmp/ellofive-serve.log 2>&1 &
        for _ in $(seq 1 40); do
          curl -sf http://127.0.0.1:11434/api/tags >/dev/null 2>&1 && break
          sleep 1
        done
      fi
      ELLOFIVE_PORT=3000 nohup node "${ROOT}/frc/server.js" >/tmp/ello5-api.log 2>&1 &
      for _ in $(seq 1 30); do
        curl -sf http://127.0.0.1:3000/v1/hosts >/dev/null 2>&1 && break
        sleep 0.3
      done
    fi
  fi
  open_url "${target}"
  cat <<'EOF'

Agent checklist (do this yourself on Ubuntu):
  [ ] Page loads without console errors
  [ ] Primary CTA / chat / form works
  [ ] Mobile-ish resize still usable
  [ ] Report PASS/FAIL with screenshots

EOF
}

case "${cmd}" in
  status|info)
    status
    ;;
  setup|install)
    setup
    ;;
  open|browse)
    open_url "${1:-}"
    ;;
  test|test-app|app)
    test_app "${1:-http://127.0.0.1:3000}"
    ;;
  -h|--help|help)
    cat <<'EOF'
ElloFive Ubuntu Cloud Lab — enterprise open-source Ubuntu for app testing

Usage:
  ellofive ubuntu status
  ellofive ubuntu setup
  ellofive ubuntu open <url>
  ellofive ubuntu test [url]     # default http://127.0.0.1:3000 (Elloten)

When the user says "test my app", run: ellofive ubuntu test <url>
Then use computer-use on the Ubuntu desktop to verify the product.
EOF
    ;;
  *)
    echo "Unknown ubuntu lab command: ${cmd}" >&2
    echo "Try: ellofive ubuntu help" >&2
    exit 1
    ;;
esac
