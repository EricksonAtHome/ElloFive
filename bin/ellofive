#!/usr/bin/env bash
# ElloFive — Elite Coding System CLI (Ollama + memory + FRC7 + DeepFakes)
set -euo pipefail

ELLOFIVE_HOST="${ELLOFIVE_HOST:-http://127.0.0.1:11434}"
export OLLAMA_HOST="${OLLAMA_HOST:-$ELLOFIVE_HOST}"

OLLAMA_BIN="${OLLAMA_BIN:-$(command -v ollama || true)}"
if [[ -z "${OLLAMA_BIN}" ]]; then
  echo "ElloFive: ollama binary not found. Run: bash scripts/install.sh" >&2
  exit 1
fi

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
if [[ -f "${ROOT}/.ellofive-models.env" ]]; then
  # shellcheck disable=SC1091
  source "${ROOT}/.ellofive-models.env"
fi

# Ensure SA / blackeye are on PATH for this process
export PATH="${ROOT}/bin:${PATH}"

cmd="${1:-}"

banner() {
  cat <<'EOF'
 _____ _ _       _____ _
| ____| | | ___ |  ___|(_)_   _____
|  _| | | |/ _ \| |_   | \ \ / / _ \
| |___| | | (_) |  _|  | |\ V /  __/
|_____|_|_|\___/|_|    |_| \_/ \___|
  Elite Coding System · private · local · FRC7 + Deep Learning
EOF
}

ensure_runtime() {
  if curl -sf "${OLLAMA_HOST}/api/tags" >/dev/null 2>&1; then
    return 0
  fi
  echo "Starting ElloFive runtime..." >&2
  nohup "${OLLAMA_BIN}" serve >/tmp/ellofive-serve.log 2>&1 &
  for _ in $(seq 1 40); do
    curl -sf "${OLLAMA_HOST}/api/tags" >/dev/null 2>&1 && return 0
    sleep 1
  done
  echo "Runtime failed to start. Check /tmp/ellofive-serve.log" >&2
  return 1
}

# SA = Start Application — run the real CLI (never ask the LLM)
run_sa_line() {
  local line="$1"
  # strip leading SA / sa
  local rest
  rest="$(echo "${line}" | sed -E 's/^[[:space:]]*[Ss][Aa][[:space:]]+//')"
  if [[ -z "${rest}" || "${rest}" == "${line}" ]]; then
    # bare "SA"
    bash "${ROOT}/bin/SA" help
    return $?
  fi
  # shellcheck disable=SC2086
  bash "${ROOT}/bin/SA" ${rest}
}

run_blackeye_line() {
  local line="$1"
  local rest
  rest="$(echo "${line}" | sed -E 's/^[[:space:]]*blackeye[[:space:]]+//I')"
  if [[ -z "${rest}" || "${rest}" == "${line}" ]]; then
    bash "${ROOT}/bin/blackeye" help
    return $?
  fi
  # shellcheck disable=SC2086
  bash "${ROOT}/bin/blackeye" ${rest}
}

is_tool_line() {
  local line="$1"
  [[ "${line}" =~ ^[[:space:]]*[Ss][Aa]([[:space:]]|$) ]] && return 0
  [[ "${line}" =~ ^[[:space:]]*[Bb][Ll][Aa][Cc][Kk][Ee][Yy][Ee]([[:space:]]|$) ]] && return 0
  return 1
}

dispatch_tool_line() {
  local line="$1"
  if [[ "${line}" =~ ^[[:space:]]*[Ss][Aa]([[:space:]]|$) ]]; then
    run_sa_line "${line}"
  else
    run_blackeye_line "${line}"
  fi
}

one_shot_ask() {
  local model="$1"
  local user_prompt="$2"
  local mem prompt
  mem="$(bash "${ROOT}/bin/ellofive-memory" context 2>/dev/null || true)"
  prompt="${user_prompt}"
  if [[ -n "${mem}" ]]; then
    prompt="${mem}

USER REQUEST:
${user_prompt}"
  fi
  "${OLLAMA_BIN}" run "${model}" "${prompt}"
}

interactive_chat() {
  local model="$1"
  ensure_runtime
  echo "(Local memory: memory/knowledge-base.md)"
  echo "SA = Start Application — type: SA list   or   SA blackeye status"
  echo "(Not software architecture. Tool lines run for real. Ctrl+C / exit to quit.)"
  echo ""
  local line
  while true; do
    printf '>>> '
    IFS= read -r line || break
    # trim
    line="${line#"${line%%[![:space:]]*}"}"
    line="${line%"${line##*[![:space:]]}"}"
    [[ -z "${line}" ]] && continue
    if [[ "${line}" == "exit" || "${line}" == "quit" || "${line}" == "/bye" ]]; then
      echo "bye"
      break
    fi
    if is_tool_line "${line}"; then
      dispatch_tool_line "${line}" || true
      echo ""
      continue
    fi
    one_shot_ask "${model}" "${line}" || true
    echo ""
  done
}

chat_with_memory() {
  local model="$1"
  shift || true
  ensure_runtime

  # No args → interactive REPL that runs SA for real
  if [[ $# -eq 0 ]]; then
    interactive_chat "${model}"
    return 0
  fi

  local user_prompt="$*"
  # One-shot: if the whole prompt is an SA/blackeye command, run it
  if is_tool_line "${user_prompt}"; then
    dispatch_tool_line "${user_prompt}"
    return $?
  fi

  one_shot_ask "${model}" "${user_prompt}"
}

case "${cmd}" in
  ""|-h|--help|help)
    banner
    echo ""
    echo "Usage: ellofive <command> [args...]"
    echo ""
    echo "Commands:"
    echo "  serve              Start Ollama runtime (→ ft.svr.ello5.com)"
    echo "  api|ui|web         Elloten UI + API (Ello5 model · ai/api.ello5.com)"
    echo "  chat [prompt]      Elite Coding chat (Pro + local memory)"
    echo "  fast [prompt]      Fast low-latency chat"
    echo "  ask <prompt>       Alias for chat with prompt"
    echo "  SA|sa <args>       Start Application (same as bin/SA)"
    echo "  blackeye <args>    Blackeye token CLI"
    echo "  memory ...         Local private knowledge base"
    echo "  run <model>        Raw ollama run"
    echo "  frc <file.frcl>    Run FRC7 FRCL"
    echo "  dl|deepfakes       DeepFakes deep learning toolkit"
    echo "  ubuntu|lab|test-app  Ubuntu Cloud Lab (test my app)"
    echo "  prompts            Standard AI prompts (SA = Start Application)"
    echo "  setup              Rebuild Elite Coding models"
    echo "  setup-all          Full auto install"
    echo "  list               List models"
    echo "  version            Version info"
    echo ""
    echo "IMPORTANT: SA = Start Application (NOT software architecture)."
    echo "  SA list"
    echo "  SA blackeye status"
    echo "  SA blackeye token create --no-prompt"
    echo ""
    echo "Use:  ellofive chat     (not plain: ollama run ellofive)"
    echo "Then type SA list — it runs the real tool."
    echo "After pulling updates: ellofive setup   # rebuild model with SA rules"
    exit 0
    ;;
  version|--version|-v)
    banner
    echo ""
    echo "ElloFive 1.4.0 — Elite Coding System"
    echo "Ello5 AI mode hosts: ai.ello5.com · api.ello5.com · ft.svr.ello5.com"
    echo "Web UX tool: Elloten · Model: Ello5"
    echo "SA = Start Application"
    "${OLLAMA_BIN}" --version
    if [[ -n "${ELLOFIVE_BASE_MODEL:-}" ]]; then
      echo "Pro base : ${ELLOFIVE_BASE_MODEL}"
      echo "Fast base: ${ELLOFIVE_FAST_MODEL:-llama3.2:3b}"
    fi
    echo "System   : models/elite-coding-system.md"
    exit 0
    ;;
  setup)
    exec bash "${ROOT}/scripts/setup-model.sh"
    ;;
  setup-all|bootstrap)
    exec bash "${ROOT}/scripts/install.sh"
    ;;
  memory|mem)
    shift || true
    exec bash "${ROOT}/bin/ellofive-memory" "$@"
    ;;
  SA|sa)
    shift || true
    exec bash "${ROOT}/bin/SA" "$@"
    ;;
  blackeye)
    shift || true
    exec bash "${ROOT}/bin/blackeye" "$@"
    ;;
  chat|pro|ask)
    shift || true
    chat_with_memory "ellofive" "$@"
    ;;
  fast)
    shift || true
    chat_with_memory "ellofive-fast" "$@"
    ;;
  frc)
    shift
    ensure_runtime
    exec node "${ROOT}/frc/cli.js" "$@"
    ;;
  dl|deepfakes|deepfake)
    shift || true
    exec bash "${ROOT}/bin/ellofive-dl" "$@"
    ;;
  ubuntu|lab|test-app|test-my-app)
    shift || true
    if [[ "${cmd}" == "test-app" || "${cmd}" == "test-my-app" ]]; then
      if [[ $# -eq 0 ]]; then
        set -- test
      elif [[ "${1}" != "status" && "${1}" != "setup" && "${1}" != "open" && "${1}" != "test" && "${1}" != "help" && "${1}" != "-h" && "${1}" != "--help" ]]; then
        set -- test "$@"
      fi
    fi
    exec bash "${ROOT}/bin/ellofive-ubuntu" "$@"
    ;;
  prompts|prompt)
    shift || true
    exec bash "${ROOT}/bin/ellofive-prompts" "$@"
    ;;
  list|ls)
    echo "ElloFive models:"
    exec "${OLLAMA_BIN}" list
    ;;
  serve)
    exec "${OLLAMA_BIN}" serve
    ;;
  api|ui|web|gateway)
    ensure_runtime
    if [[ -f "${ROOT}/config/hosts.env" ]]; then
      # shellcheck disable=SC1091
      set -a
      source "${ROOT}/config/hosts.env"
      set +a
    fi
    exec node "${ROOT}/frc/server.js"
    ;;
  *)
    exec "${OLLAMA_BIN}" "$@"
    ;;
esac
